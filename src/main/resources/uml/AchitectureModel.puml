@startuml
    Title Antsim - Architettura del sistema

    skinparam componentStyle rectangle
    skinparam linetype ortho
    skinparam packageStyle rectangle
    skinparam shadowing false
    skinparam padding 8
    skinparam nodesep 50
    skinparam ranksep 50

    actor "Utente" as User

    package "Presentation Layer" {
        component "SimulationView\n(JavaFX)" as View
        component "EditorTool\nWorldEdit" as Editor
    }

    package "Application Layer" {
        component "SimulationController" as Controller
        component "JavaFX Timeline" as Timeline
    }

    package "Domain Layer" {
        package "Domain / Simulation Layer" {
            component "SimulationEngine" as Engine
            component "SimulationClock" as Clock
            component "SimulationStatistics" as Statistics
        }

        package "Domain / Agent Layer" {
            component "Ant\nAntGroup\nAntFactory" as Agents
            interface "DecisionEngine" as DecisionEngine
            component "AcoDecisionEngine" as Aco
            component "AcoParameters" as AcoParameters
        }

        package "Domain / World Layer" {
            component "World\nGrid\nCell\nCellContent" as World
            component "WorldGenerator" as Generator
            component "GenerationParameters" as GenerationParameters
        }

        package "Domain / Pheromone Layer" {
            interface "PheromoneField" as PheromoneField
            component "PheromoneMap" as PheromoneMap
            interface "EvaporationModel" as EvaporationModel
            component "Evaporation" as Evaporation
        }
    }

    component "Main\nComposition Root" as Main

    ' --- POSIZIONAMENTO PACKAGE---
    "Presentation Layer" -[hidden]down-> "Application Layer"
    "Application Layer" -[hidden]down-> "Domain Layer"

    "Domain / Simulation Layer" -[hidden]right-> "Domain / World Layer"
    "Domain / World Layer" -[hidden]down-> "Domain / Agent Layer"
    "Domain / Agent Layer" -[hidden]right-> "Domain / Pheromone Layer"

    ' --- PRESENTATION & APPLICATION ---
    User --> View : usa interfaccia
    View --> Editor : crea modifiche mappa
    View -right-> Controller : callback(avvia/pausa/reset)
    Timeline -down-> Controller : tick ogni 33 ms
    Controller .left.> View : render(world,\nferomoni, formiche, statistiche)

    ' --- APPLICATION TO DOMAIN ---
    controller -down--> Engine : comandi applicativi\nstep(dt)
    Controller ..> World : applica WorldEdit

    ' --- SIMULATION ENGINE ---
    Engine -down-> Clock : avanza il tempo
    Engine -down-> Statistics : produce snapshot
    Engine .down.> Agents : aggiorna formiche
    Engine -down-> World : raccolta cibo,\nconsegna al nido
    Engine -down-> PheromoneField : deposito,\nevaporazione
    Engine ..> Generator : genera scenario

    ' --- AGENT LAYER ---
    Agents -down-> DecisionEngine : calcola direzione
    Aco .up.|> DecisionEngine
    Aco -right-> AcoParameters
    Agents ..> World : movimento/collisioni
    Agents ..> PheromoneField : percezione

    ' --- PHEROMONE LAYER ---
    PheromoneMap .up.|> PheromoneField
    PheromoneMap -right-> EvaporationModel
    Evaporation .up.|> EvaporationModel

    ' --- WORLD LAYER ---
    Generator -right-> GenerationParameters
    Generator ..> World : crea

    ' --- ROOT (MAIN) ---
    Main ..> Controller : configura
    Main ..> Engine : inietta dipendenze
    Main ..> PheromoneMap : crea
    Main ..> Aco : crea
    Main ..> Generator : crea

    ' --- NOTE ARCHITETTURALI ---
    note top of View
        La view non contiene logica
        di simulazione, visualizza lo stato
        e inoltra gli eventi dell'utente.
    end note

    note bottom of Controller
        Coordina UI e motore.
        Non implementa le regole
        del dominio.
    end note

    note bottom of Engine
        Centro applicativo della simulazione.
        Coordina il passo discreto delegando le
        regole specifiche agli oggetti dominio.
    end note

    note bottom of World
        Dominio indipendente da JavaFX
    end note
@enduml